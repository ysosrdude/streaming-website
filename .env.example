# Override StreamCenter base URL only
# VITE_API_BASE_URL=https://streamcenter.st

# Full feed list (JSON array). Each entry needs id, name, baseUrl, and kind.
# kind must be "streamcenter" or "trendy48"
# VITE_FEED_PROVIDERS=[{"id":"streamcenter","name":"StreamCenter","baseUrl":"https://streamcenter.st","kind":"streamcenter"},{"id":"trendy48","name":"Trendy48","baseUrl":"https://trendy48.online/api","kind":"trendy48"}]
